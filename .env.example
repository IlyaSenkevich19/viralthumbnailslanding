# Support widget → ViralThumbnails Nest POST /api/support/contact (CORS must allow this landing origin)
NEXT_PUBLIC_SUPPORT_API_URL=https://your-api-host.example.com/api/support/contact

# Google Tag Manager (preferred: configure GA4 + Google Ads inside GTM)
NEXT_PUBLIC_GTM_ID=

# If GTM is empty, you can use gtag directly (one or both):
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
