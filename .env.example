# Support widget → ViralThumbnails Nest POST /api/support/contact (CORS must allow this landing origin)
NEXT_PUBLIC_SUPPORT_API_URL=https://your-api-host.example.com/api/support/contact

# Privacy / legal / support contact (Terms, Privacy, support widget header)
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=ilya.senkevich.199@gmail.com

# Analytics: one GTM container only. Add GA4 + Google Ads as tags inside GTM (do not set separate NEXT_PUBLIC_* for GA/Ads here).
NEXT_PUBLIC_GTM_ID=

# Stripe Payment Links (partner) — empty = paid plan buttons link to app /credits instead.
# Partner success URL for Stripe: https://app.viralthumblify.com/payment/success?pack=100|300|700
# (www also redirects /payment/success → app)
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_PACK_100=
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_PACK_300=
NEXT_PUBLIC_STRIPE_CHECKOUT_URL_PACK_700=
# Pricing UI visibility (comma-separated). Unset = trial,pack_100 for partner test with one $29 link.
# Full lineup: trial,pack_100,pack_300,pack_700
NEXT_PUBLIC_ENABLED_PRICING_PLAN_IDS=
